# Backend Environment Variables

# Database
DATABASE_URL=mongodb://localhost:27017/smarthome

# MQTT Broker
MQTT_BROKER=192.168.1.7
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Doorbell Encryption Key (Base64-encoded Fernet key from Raspberry Pi)
# Generate on Raspberry Pi by running: python3 main
# Then copy the output and set it here
# Example: DOORBELL_ENCRYPTION_KEY=gAAAAABn_...==
DOORBELL_ENCRYPTION_KEY=

# Optional: JWT Secret for authentication
JWT_SECRET=your-secret-key-here

# Server Port
PORT=3000
